{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadGoal": {
      "properties": {
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "objective": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ThreadGoalStatus"
        },
        "threadId": {
          "type": "string"
        },
        "timeUsedSeconds": {
          "format": "int64",
          "type": "integer"
        },
        "tokenBudget": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "tokensUsed": {
          "format": "int64",
          "type": "integer"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "createdAt",
        "objective",
        "status",
        "threadId",
        "timeUsedSeconds",
        "tokensUsed",
        "updatedAt"
      ],
      "type": "object"
    },
    "ThreadGoalActivationDisposition": {
      "description": "Admission is not evidence of incorporation, goal completion or hearing.",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "uncertain"
              ],
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "started"
              ],
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "turn_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "steered"
              ],
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "turn_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "notStarted"
              ],
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ThreadGoalStatus": {
      "enum": [
        "active",
        "paused",
        "blocked",
        "usageLimited",
        "budgetLimited",
        "complete"
      ],
      "type": "string"
    }
  },
  "properties": {
    "activation": {
      "$ref": "#/definitions/ThreadGoalActivationDisposition"
    },
    "goal": {
      "$ref": "#/definitions/ThreadGoal"
    },
    "revision": {
      "type": "string"
    }
  },
  "required": [
    "activation",
    "goal",
    "revision"
  ],
  "title": "ThreadGoalConditionalActivateResponse",
  "type": "object"
}