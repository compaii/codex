{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AdditionalContextEntry": {
      "properties": {
        "kind": {
          "$ref": "#/definitions/AdditionalContextKind"
        },
        "name": {
          "description": "Optional name for untrusted context, used to label its tool output.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "type": "object"
    },
    "AdditionalContextKind": {
      "enum": [
        "untrusted",
        "application"
      ],
      "type": "string"
    },
    "ThreadGoalMutationOrigin": {
      "description": "Distinguishes explicit user actions from automatic goal lifecycle mutations.",
      "enum": [
        "user",
        "automatic"
      ],
      "type": "string"
    }
  },
  "properties": {
    "additionalContext": {
      "additionalProperties": {
        "$ref": "#/definitions/AdditionalContextEntry"
      },
      "type": "object"
    },
    "expectedRevision": {
      "type": "string"
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "origin": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThreadGoalMutationOrigin"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    },
    "tokenBudget": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "additionalContext",
    "expectedRevision",
    "threadId"
  ],
  "title": "ThreadGoalConditionalActivateParams",
  "type": "object"
}